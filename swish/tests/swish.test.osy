using Osysharp.Http;
using Osysharp.Payments.Swish;

// The rules Swish enforces, applied by the kit before Swish has to refuse — and the two things a page draws.

[Test]
void an_amount_goes_up_as_kronor_with_two_decimals_computed_from_ore() {
  Assert.Equal("129.00", SwishAmount(12900));
  Assert.Equal("0.05", SwishAmount(5));
  Assert.Equal("1000.10", SwishAmount(100010));
  Assert.Equal(12900, SwishMinor(129.00m));
  var refusal = Assert.Throws<ExternalServiceException>(() => SwishAmount(0));
  Assert.Contains("0.01", refusal.Message);
}

[Test]
void the_message_is_made_to_fit_what_swish_takes() {
  Assert.Equal("Grounds and Grapes, order GG 1041", SwishMessage("Grounds & Grapes — order GG-1041"));
  var fitted = SwishMessage("Kiambu AA and Pét-nat Rosé and a monthly wine box for the whole of next year, please");
  Assert.True(fitted.Length <= 50);
  Assert.DoesNotContain("-", fitted);
  Assert.True(Regex.IsMatch(fitted, "^[a-zA-Z0-9åäöÅÄÖéÉüÜ :;.,?!()\"]*$"));
}

[Test]
void an_instruction_id_is_swishs_shape_and_the_same_seed_is_the_same_id() {
  var a = SwishInstructionId("o-1#1");
  Assert.True(IsSwishId(a));
  Assert.Equal(32, a.Length);
  Assert.Equal("4", a.Substring(12, 1));                       // an RFC 4122 version Swish accepts
  Assert.Contains(a.Substring(16, 1), "89AB");                 // …and its variant
  Assert.Equal(a, SwishInstructionId("o-1#1"));                // a retry is the SAME request
  Assert.NotEqual(a, SwishInstructionId("o-1#2"));
  Assert.NotEqual(a, SwishInstructionId("o-2#1"));
  Assert.False(IsSwishId(a.ToLower()));
  Assert.False(IsSwishId("../refunds/" + a.Substring(0, 22)));
}

[Test]
void a_reference_swish_would_refuse_is_refused_here_by_name() {
  Assert.Equal("GG-1041", SwishReference("GG-1041"));
  var refusal = Assert.Throws<ExternalServiceException>(() => SwishReference("GG 1041 & more"));
  Assert.Contains("GG 1041 & more", refusal.Message);
}

[Test]
void a_swedish_mobile_number_is_written_the_way_swish_reads_a_payer() {
  Assert.Equal("46701234567", SwishPhone("070-123 45 67"));
  Assert.Equal("46701234567", SwishPhone("+46 70 123 45 67"));
  Assert.Equal("46701234567", SwishPhone("0046701234567"));
  var refusal = Assert.Throws<ExternalServiceException>(() => SwishPhone("12"));
  Assert.Contains("country code", refusal.Message);
}

[Test]
void an_id_that_is_not_swishs_never_reaches_a_url() {
  // Ids arrive from addresses and callbacks. One that is not 32 upper-case hex digits is refused before any request is
  // built from it, so it cannot steer a call to another path of the API.
  List<string> asked = [];
  Http.Get.Stub((url, headers) => { asked.Add(url); return NotFound(); });
  Assert.Throws<ExternalServiceException>(() => Provider().Client().GetPaymentRequest("../refunds/1E2FC19E"));
  Assert.Empty(asked);
}

[Test]
void the_qr_code_is_drawn_by_swish_from_the_token_and_comes_back_as_a_picture() {
  List<string> urls = [];
  List<string> bodies = [];
  Http.Post.Stub((url, body, headers) => {
    urls.Add(url); bodies.Add(body);
    return new HttpResponse { StatusCode = 200, Body = "", Bytes = Text.ToBytes("PNG-BYTES") };
  });
  var image = Provider().QrCode("umP7Eg2HT_OUId8Mc0FHPCxhX3Hkh4qI");
  Assert.Equal("https://mpc.getswish.net/qrg-swish/api/v1/commerce", urls[0]);
  Assert.Contains("\"token\":\"umP7Eg2HT_OUId8Mc0FHPCxhX3Hkh4qI\"", bodies[0]);
  Assert.Contains("\"format\":\"png\"", bodies[0]);
  Assert.Equal("PNG-BYTES", Text.FromBytes(image));
}

[Test]
void the_app_link_opens_swish_with_the_token_and_comes_back_to_the_shop() {
  var link = Provider().AppLink("tok123", "https://shop.test/paid/GG-1041/swish-ABC");
  Assert.Equal("swish://paymentrequest?token=tok123&callbackurl=https%3A%2F%2Fshop.test%2Fpaid%2FGG-1041%2Fswish-ABC", link);
}

// Osysharp.Payments — the contract between an app that takes money and the provider that moves it.
//
// A shop, a booking system or an invoice page depends on THIS package and on no provider in particular; each provider
// (Stripe, Klarna, a bank, Apple Pay, your own) is a class implementing `IPaymentProvider`, shipped in its own package
// or written in the app. The app lists the providers it offers, and adding one never touches the code that sells.
package Osysharp.Payments {
  version     "0.1.0";
  minPlatform "0.9.0";
  summary     "the payment-provider contract — start, confirm, capture, refund, cancel and webhook events — plus manual payment.";
  model "model/*.osy";
  tests "tests";
}
